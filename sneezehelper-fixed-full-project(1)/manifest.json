{
  "manifest_version": 3,
  "name": "Sneeze Helper",
  "version": "1.0.0",
  "description": "A quick dark-to-bright screen transition for people who experience the photic sneeze reflex.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sneeze Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}